# Zkopíruj do .env (ten je v .gitignore). Do tohoto souboru žádné skutečné hodnoty.
HEALTH_DB_PATH=data/health.db


# E-maily, které smějí do aplikace (přihlášení Googlem přes Rozcestník). Jen vlastník, čárkou oddělené.
ALLOWED_EMAILS=
# Osobní API klíč z Garmin Connect (Web > Personal API Key). Zobrazí se jen jednou, ulož ho jen sem.
GARMIN_API_KEY=
# Další osoby mají vlastní klíč v proměnné GARMIN_API_KEY_<id osoby>, např. GARMIN_API_KEY_2 (návod v docs/garmin.md)

# Automatická synchronizace Garminu: interval v hodinách (0 = vypnuto) a kolik posledních dní se pokaždé obnoví
AUTO_SYNC_HOURS=6
AUTO_SYNC_DAYS=7

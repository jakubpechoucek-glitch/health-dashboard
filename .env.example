# Zkopíruj do .env (ten je v .gitignore). Do tohoto souboru žádné skutečné hodnoty.
HEALTH_DB_PATH=data/health.db

# Tajná část URL pro příchozí push z Garminu: /garmin/webhook/<token>
# Vygeneruj: python -c "import secrets; print(secrets.token_urlsafe(32))"
GARMIN_WEBHOOK_TOKEN=change-me

# Přihlašovací údaje aplikace z Garmin developer portálu
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=

# Přihlášení do aplikace. Heslo dlouhé a náhodné: python -c "import secrets; print(secrets.token_urlsafe(24))"
APP_USER=jakub
APP_PASSWORD=
# Token z Garmin Personal API (viz docs/garmin.md)
GARMIN_API_KEY=
